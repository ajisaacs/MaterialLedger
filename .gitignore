# Ignore thumbnails created by Windows
Thumbs.db
# Ignore files built by Visual Studio
*.obj
*.exe
*.pdb
*.user
*.cache
*.ilk
bin/
obj/
.vs/

# ASP.NET Core Data Protection keys (see Program.cs AddDataProtection/PersistKeysToFileSystem) —
# key material must never be committed; default relative path used when DataProtection:KeyPath
# is not configured.
keys/
MaterialLedger.Web/keys/

# Subagent-driven-development scratch workspace (ledgers, briefs, review packages) — not part of
# the shipped codebase.
.superpowers/

# Playwright MCP browser-session scratch output (console logs, page snapshots, screenshots).
.playwright-mcp/

# Local git worktrees used for isolated feature/plan work.
.worktrees/
