@page "{id:long}"
@model MaterialLedger.Web.Pages.Vendors.DetailsModel
@using MaterialLedger.Data.Models
@{ Layout = "Shared/_Layout"; ViewData["Title"] = Model.Vendor!.Name; }
<header class="page-heading"><p class="eyebrow">Vendor</p><h1>@Model.Vendor!.Name</h1><p>@(Model.Vendor.IsActive ? "Active" : "Inactive") · @(Model.Vendor.ContactName ?? "No contact name")</p>@if (User.IsInRole("Programmer") || User.IsInRole("Manager")) { <p><a asp-page="Edit" asp-route-id="@Model.Id">Edit vendor</a></p> }</header>
@if (Model.Error is not null) { <p class="form-error" role="alert">@Model.Error</p> }
<section><h2>Vendor parts</h2><table><thead><tr><th>Part</th><th>Description</th><th>MOQ</th><th>Unit</th><th>Status</th></tr></thead><tbody>@foreach(var part in Model.Parts) { <tr><td><a asp-route-id="@Model.Id" asp-route-vendorPartId="@part.VendorPartId">@part.PartNumber</a></td><td>@(part.Description ?? "—")</td><td>@(part.MinimumOrderQty?.ToString() ?? "—")</td><td>@(part.Unit ?? "—")</td><td>@(part.IsActive ? "Active" : "Inactive")</td></tr> }</tbody></table></section>
@if (User.IsInRole("Programmer") || User.IsInRole("Manager")) { <section><h2>Add vendor part</h2><form method="post" asp-page-handler="AddPart"><label>Part number <input asp-for="NewPart.PartNumber" maxlength="100" required /></label><label>Description <input asp-for="NewPart.Description" maxlength="1000" /></label><label>Minimum order quantity <input asp-for="NewPart.MinimumOrderQty" type="number" step="0.001" min="0.001" /></label><label>Unit <input asp-for="NewPart.Unit" maxlength="50" /></label><button type="submit">Add part</button></form></section> }
@if (Model.VendorPartId is not null && Model.Summary is not null) { <section><h2>Price history</h2><p>Last actual: @(Model.Summary.LastActual?.ToString("0.00") ?? "—") · Average actual: @(Model.Summary.AvgActual?.ToString("0.00") ?? "—") · @Model.Summary.ActualPoints actual / @Model.Summary.QuotedPoints quoted points</p><h3>Actual receipts</h3><table><thead><tr><th>Received</th><th>Cost/unit</th><th>PO</th><th>Receipt</th></tr></thead><tbody>@foreach(var point in Model.Actuals) { <tr><td>@point.ReceivedAtUtc.ToString("g")</td><td>@point.CostPerUnit.ToString("0.00")</td><td>@point.PurchaseOrderNumber</td><td>@point.ReceiptNumber</td></tr> }</tbody></table><h3>PO quotes</h3><table><thead><tr><th>Order date</th><th>Price</th><th>Quantity</th><th>Status</th></tr></thead><tbody>@foreach(var point in Model.Quotes) { <tr><td>@(point.OrderDate?.ToString("d") ?? "Unavailable")</td><td>@point.UnitPrice.ToString("0.00")</td><td>@point.QuantityOrdered</td><td>@point.Status</td></tr> }</tbody></table></section> }
<p><a asp-page="Index">Back to vendors</a></p>
