@page
@model MaterialLedger.Web.Pages.PepNests.IndexModel
@{ Layout = "Shared/_Layout"; ViewData["Title"] = "PEP nests"; }

<header class="page-heading">
    <p class="eyebrow">Cutting workflow</p>
    <h1>View PEP nests</h1>
    <p>PEP is the source for nest material and plate requirements. A Material Ledger hold is created only after you select a mapped on-hand item.</p>
</header>

<form method="get" class="filter-bar">
    <label>Year <input asp-for="Year" type="number" min="2000" max="2100" /></label>
    <label>Status
        <select asp-for="Status">
            <option value="">All statuses</option>
            <option value="To be cut">To be cut</option>
            <option value="Quote">Quote</option>
            <option value="Has been cut">Has been cut</option>
            <option value="Hold">Hold</option>
            <option value="Quote, accepted, to be cut">Quote, accepted, to be cut</option>
            <option value="Quote, accepted, has been cut">Quote, accepted, has been cut</option>
            <option value="Quote, accepted, hold">Quote, accepted, hold</option>
            <option value="Quote, accepted, moved to wip">Quote, accepted, moved to wip</option>
            <option value="Quote, rejected">Quote, rejected</option>
            <option value="Quote, timed out">Quote, timed out</option>
            <option value="Deleted">Deleted</option>
            <option value="N/A">N/A</option>
        </select>
    </label>
    <label>Customer <input asp-for="Customer" list="customerOptions" autocomplete="off" /></label>
    <datalist id="customerOptions">
        @foreach (var customer in Model.CustomerOptions) { <option value="@customer"></option> }
    </datalist>
    <button type="submit">Find nests</button>
</form>

@if (Model.Error is not null) { <p class="form-error" role="alert">@Model.Error</p> }
else
{
    <p role="status">@Model.Nests.Count nest(s) found.</p>
    <table>
        <thead><tr><th>Nest</th><th>Status</th><th>Customer</th><th>PEP material</th><th>Created</th><th></th></tr></thead>
        <tbody>
        @foreach (var nest in Model.Nests)
        {
            <tr>
                <td>@nest.Name</td><td>@nest.Status</td><td>@nest.Customer</td>
                <td>@nest.MaterialDescription, @nest.MaterialGrade</td><td>@nest.DateCreated.ToString("yyyy-MM-dd")</td>
                <td><a asp-page="Details" asp-route-year="@Model.Year" asp-route-nestName="@nest.Name">View nest</a></td>
            </tr>
        }
        </tbody>
    </table>
}
