@page "{year:int}/{nestName}"
@model MaterialLedger.Web.Pages.PepNests.DetailsModel
@using MaterialLedger.Data.Models
@using MaterialLedger.Web.Shared
@{ Layout = "Shared/_Layout"; ViewData["Title"] = "PEP nest"; }

<p><a asp-page="Index" asp-route-year="@RouteData.Values["year"]">← Back to PEP nests</a></p>
@if (Model.Nest is null)
{
    <p class="form-error" role="alert">@Model.Error</p>
}
else
{
    <header class="page-heading">
        <p class="eyebrow">PEP nest</p>
        <div class="page-heading-title">
            <h1>@Model.Nest.Name</h1>
            <span class="filter-chip">@Model.Nest.Status</span>
        </div>
        <p>Customer @Model.Nest.Customer · Created @Model.Nest.DateCreated.ToString("yyyy-MM-dd")</p>
    </header>

    @if (Model.Nest.Status?.Contains("has been cut", StringComparison.OrdinalIgnoreCase) == true)
    {
        <p class="warning-banner" role="alert">⚠ This program has already been cut.</p>
    }

    @if (Model.Error is not null) { <p class="form-error" role="alert">@Model.Error</p> }

    <section aria-label="PEP material">
        <h2>PEP material</h2>
        <dl class="detail-grid">
            <dt>Material number</dt><dd>#@Model.Nest.Material?.Number</dd>
            <dt>Grade</dt><dd>@Model.Nest.Material?.Grade</dd>
            <dt>Thickness</dt><dd>@Model.Nest.Material?.Thickness.ToString("0.####") in</dd>
            <dt>Description</dt><dd>@Model.Nest.Material?.Description</dd>
        </dl>
    </section>

    @if (User.IsInRole("Programmer") || User.IsInRole("Manager"))
    {
        <section aria-label="Material mapping">
            <h2>Map to Material Ledger catalog</h2>
            <p>The selected catalog material is the approved Material Ledger equivalent for PEP material #@Model.Nest.Material?.Number.</p>
            <form method="post" action="?handler=Map">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="CorrelationId" value="@Guid.NewGuid()" />
                <label>Material Ledger catalog material
                    <select asp-for="MaterialSpecId">
                        <option value="">-- select material --</option>
                        @foreach (var material in Model.MaterialSpecs) { <option value="@material.MaterialSpecId">@material.DisplayName</option> }
                    </select>
                </label>
                <button type="submit" class="button button-primary">Save PEP material map</button>
            </form>
            @if (Model.Mapping?.MaterialSpec is not null) { <p class="alert-success" role="status">Mapped to @Model.Mapping.MaterialSpec.DisplayName.</p> }
        </section>
    }

    <section aria-label="On-hand material">
        <h2>On-hand material for this nest</h2>
        @if (Model.Mapping?.MaterialSpec is null)
        {
            <p class="empty-state">Map this PEP material to the Material Ledger catalog before selecting on-hand material.</p>
        }
        else if (Model.AvailableItems.Count == 0)
        {
            <p class="empty-state">No current, available Material Ledger items match @Model.Mapping.MaterialSpec.DisplayName.</p>
        }
        else
        {
            <table>
                <thead><tr><th>Item</th><th>Available</th><th>Usable size</th><th>Location</th><th></th></tr></thead>
                <tbody>
                @foreach (var item in Model.AvailableItems)
                {
                    <tr>
                        <td>@item.PublicItemCode</td>
                        <td>@DisplayFormat.Quantity(item.AvailableQuantity)</td>
                        <td>@item.UsableWidthIn × @item.UsableLengthIn in</td>
                        <td>@item.LocationCode</td>
                        <td class="queue-action"><a class="button button-primary" asp-page="/Reservations/Create" asp-route-inventoryItemId="@item.InventoryItemId" asp-route-pepNestYear="@RouteData.Values["year"]" asp-route-pepNestName="@Model.Nest.Name" asp-route-pepMaterialNumber="@Model.Nest.Material?.Number">Create material hold</a></td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>

    <section aria-label="Parts">
        <h2>Parts</h2>
        @if (Model.Nest.Parts.Count == 0)
        {
            <p class="empty-state">No parts recorded for this nest.</p>
        }
        else
        {
            <table>
                <thead><tr><th>Part</th><th>Nested</th><th>Required</th></tr></thead>
                <tbody>
                @foreach (var part in Model.Nest.Parts)
                {
                    <tr><td>@part.Name</td><td>@part.QtyNested</td><td>@part.QtyRequired</td></tr>
                }
                </tbody>
            </table>
        }
    </section>
}
