@* MaterialLedger.Web/Pages/Closeout/Details.cshtml *@
@page "{id:long}"
@model MaterialLedger.Web.Pages.Closeout.DetailsModel
@using MaterialLedger.Data.Models
@using MaterialLedger.Web.Shared
@{ Layout = "Shared/_Layout"; }
<section class="closeout-detail">
    <p class="eyebrow">Cut-result closeout</p>
    <h1>Record cut result</h1>
    <p>Record what physically remains from this cut. This updates material availability only after you submit the outcome.</p>

    @if (Model.Error is not null)
    {
        <p class="form-error" role="alert">@Model.Error</p>
    }

    <dl class="closeout-context">
        <dt>Material</dt><dd>@Model.Reservation!.InventoryItem?.PublicItemCode — @Model.Reservation.InventoryItem?.MaterialSpec?.DisplayName</dd>
        <dt>Source location</dt><dd>@Model.Reservation.InventoryItem?.InventoryLocation?.LocationCode</dd>
        <dt>Work reference</dt><dd>@Model.WorkReference</dd>
        <dt>Equipment</dt><dd>@Model.Reservation.Equipment</dd>
        <dt>Workflow status</dt><dd>@ReservationWorkflowDisplay.For(Model.Reservation.Status).Label</dd>
        <dt>Expected usable drops</dt>
        <dd>
            @if (Model.Reservation.ExpectedRemnants.Count > 0)
            {
                <ul>
                    @foreach (var remainder in Model.Reservation.ExpectedRemnants.OrderBy(x => x.Sequence))
                    {
                        <li>@remainder.WidthIn × @remainder.LengthIn in (@remainder.SourceType)</li>
                    }
                </ul>
            }
            else if (Model.Reservation.ExpectedRemainderWidthIn is not null)
            {
                @($"{Model.Reservation.ExpectedRemainderWidthIn} × {Model.Reservation.ExpectedRemainderLengthIn} ({Model.Reservation.ExpectedRemainderSourceType})")
            }
            else
            {
                @:No estimate recorded
            }
        </dd>
    </dl>

    <form method="post" action="?handler=Closeout" class="closeout-decision">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CorrelationId" />
        <input type="hidden" name="ExpectedRowVersionBase64" value="@Convert.ToBase64String(Model.Reservation.RowVersion)" />
        <input type="hidden" asp-for="Status" />
        <input type="hidden" asp-for="Equipment" />

        <fieldset>
            <legend>After the cut, what remains?</legend>
            <p class="form-hint">Select the one physical outcome that was observed.</p>
            <div class="outcome-options">
                <label class="outcome-option" for="outcome-consumed">
                    <input id="outcome-consumed" type="radio" name="Outcome" value="AllConsumed" checked="@(Model.Outcome == ProductionConsumptionOutcome.AllConsumed)" />
                    <span><strong>Nothing usable remains</strong><small>Material was consumed or remaining pieces are scrap.</small></span>
                </label>
                <label class="outcome-option" for="outcome-returned">
                    <input id="outcome-returned" type="radio" name="Outcome" value="FullSheetReturned" checked="@(Model.Outcome == ProductionConsumptionOutcome.FullSheetReturned)" />
                    <span><strong>Full sheet returned</strong><small>The original sheet is back in its source location.</small></span>
                </label>
                <label class="outcome-option" for="outcome-drop">
                    <input id="outcome-drop" type="radio" name="Outcome" value="UsableDropCreated" checked="@(Model.Outcome == ProductionConsumptionOutcome.UsableDropCreated)" />
                    <span><strong>Usable rectangular drop remains</strong><small>Measure it and record where it was placed.</small></span>
                </label>
                <label class="outcome-option" for="outcome-review">
                    <input id="outcome-review" type="radio" name="Outcome" value="NeedsReview" checked="@(Model.Outcome == ProductionConsumptionOutcome.NeedsReview)" />
                    <span><strong>Material needs review</strong><small>Use when the physical outcome is unknown or needs follow-up.</small></span>
                </label>
            </div>
        </fieldset>

        <fieldset class="closeout-drop-fields" data-outcome="UsableDropCreated">
            <legend>Usable drop details</legend>
            <p class="form-hint">Record every usable rectangular drop. Measurements and destination are validated on submit.</p>
            <div id="remnant-list">
                <div class="remnant-entry">
                    <label>Measured usable width (in) <input name="Remnants[0].MeasuredUsableWidthIn" value="@Model.Remnants[0].MeasuredUsableWidthIn" type="number" min="0.001" step="0.001" /></label>
                    <label>Measured usable length (in) <input name="Remnants[0].MeasuredUsableLengthIn" value="@Model.Remnants[0].MeasuredUsableLengthIn" type="number" min="0.001" step="0.001" /></label>
                    <label>Destination slot
                        <select name="Remnants[0].DestinationLocationId">
                            <option value="">-- select --</option>
                            @foreach (var loc in Model.DestinationChoices)
                            {
                                <option value="@loc.InventoryLocationId" selected="@(Model.Remnants[0].DestinationLocationId == loc.InventoryLocationId)">@loc.LocationCode — @loc.DisplayName</option>
                            }
                        </select>
                    </label>
                </div>
            </div>
            <button id="add-remnant" type="button" class="button button-secondary">Add another drop</button>
            <template id="remnant-template">
                <div class="remnant-entry">
                    <label>Measured usable width (in) <input name="Remnants[__index__].MeasuredUsableWidthIn" type="number" min="0.001" step="0.001" /></label>
                    <label>Measured usable length (in) <input name="Remnants[__index__].MeasuredUsableLengthIn" type="number" min="0.001" step="0.001" /></label>
                    <label>Destination slot
                        <select name="Remnants[__index__].DestinationLocationId">
                            <option value="">-- select --</option>
                            @foreach (var loc in Model.DestinationChoices)
                            {
                                <option value="@loc.InventoryLocationId">@loc.LocationCode — @loc.DisplayName</option>
                            }
                        </select>
                    </label>
                </div>
            </template>
        </fieldset>

        <label class="closeout-notes">Notes (optional; explain review-needed outcomes)
            <textarea asp-for="Notes" maxlength="1000"></textarea>
        </label>
        <button type="submit" class="button button-primary">Record cut result</button>
    </form>
</section>

<script>
    document.getElementById("add-remnant")?.addEventListener("click", () => {
        const list = document.getElementById("remnant-list");
        const template = document.getElementById("remnant-template");
        if (!list || !template) return;
        const index = list.querySelectorAll(".remnant-entry").length;
        const fragment = template.content.cloneNode(true);
        fragment.querySelectorAll("[name]").forEach(input => input.name = input.name.replace("__index__", index));
        list.appendChild(fragment);
    });
</script>

<p><a asp-page="Index" asp-route-Status="@Model.Status" asp-route-Equipment="@Model.Equipment">Back to cut-result queue</a></p>
