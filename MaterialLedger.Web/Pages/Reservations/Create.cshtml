@* MaterialLedger.Web/Pages/Reservations/Create.cshtml *@
@page "{inventoryItemId:long?}"
@model MaterialLedger.Web.Pages.Reservations.CreateModel
@using MaterialLedger.Web.Shared
@{ Layout = "Shared/_Layout"; }

<header class="page-heading">
    <p class="eyebrow">Cutting workflow</p>
    <h1>Hold material for work</h1>
    <p>Record the work context that is known now. Additional identifiers stay available without blocking the hold.</p>
    @if (!string.IsNullOrWhiteSpace(Model.PepNestName)) { <p role="status">Creating a material hold from PEP nest <strong>@Model.PepNestName</strong>.</p> }
</header>

<section aria-label="Selected material">
    <h2>Selected material</h2>
    <table class="selected-material-summary">
        <tbody>
            <tr><th scope="row">Item</th><td>@Model.Item?.PublicItemCode</td></tr>
            <tr><th scope="row">Material</th><td>@Model.Item?.MaterialSpecDisplayName</td></tr>
            <tr><th scope="row">Available quantity</th><td>@(Model.Item is null ? null : DisplayFormat.Quantity(Model.Item.AvailableQuantity))</td></tr>
            <tr><th scope="row">Usable size</th><td>@(Model.Item?.UsableWidthIn is not null ? $"{Model.Item.UsableWidthIn} × {Model.Item.UsableLengthIn} in" : "Not recorded")</td></tr>
            <tr><th scope="row">Location</th><td>@Model.Item?.LocationCode</td></tr>
        </tbody>
    </table>
</section>

@if (Model.Error is not null)
{
    <p class="form-error" role="alert">@Model.Error</p>
}

<form method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="InventoryItemId" />
    <input type="hidden" asp-for="CorrelationId" />

    <fieldset>
        <legend>Work details</legend>
        <label>Work reference <input asp-for="DrawingId" /></label>
        <p>Enter the job, drawing, or nest identifier your team will recognize. Leave it blank only for an <strong>Unassigned material hold</strong>.</p>
    </fieldset>

    <fieldset>
        <legend>Equipment</legend>
        <label>Equipment
            <select asp-for="Equipment">
                <option value="">-- unspecified --</option>
                <option value="Laser">Laser</option>
                <option value="Plasma">Plasma</option>
                <option value="Shear">Shear</option>
                <option value="Other">Other</option>
            </select>
        </label>
    </fieldset>

    <fieldset>
        <legend>Expected usable drops</legend>
        <div id="expected-drop-list">
            @for (var index = 0; index < Model.ExpectedDropSizes.Count; index++)
            {
                <label>Expected usable drop size (in) <input class="expected-drop-size" name="ExpectedDropSizes[@index]" value="@Model.ExpectedDropSizes[index]" placeholder="0.0x0.0" autocomplete="off" /></label>
            }
        </div>
        <template id="expected-drop-template">
            <label>Expected usable drop size (in) <input class="expected-drop-size" name="ExpectedDropSizes[__index__]" placeholder="0.0x0.0" autocomplete="off" /></label>
        </template>
        <p>Optional. Leave the first box blank when no usable drops are expected. Enter width × length, for example <code>12.5x24</code> or <code>12 1/2 x 24 3/8</code>. Another box appears when the last size is valid.</p>
    </fieldset>

    <details class="additional-traceability">
        <summary>Additional traceability</summary>
        <p>Optional technical identifiers are retained for audit and can be recorded when available.</p>
        <label>ShopOps job ID <input asp-for="ShopOpsJobId" /></label>
        <label>Drawing revision <input asp-for="DrawingRevision" /></label>
        <label>PEP nest year <input asp-for="PepNestYear" type="number" /></label>
        <label>PEP nest name <input asp-for="PepNestName" /></label>
        <label>Program record ID <input asp-for="LaserProgramRecordId" /></label>
    </details>

    <button type="submit">Hold material for work</button>
</form>

<script>
    const expectedDropList = document.getElementById("expected-drop-list");
    const expectedDropTemplate = document.getElementById("expected-drop-template");
    const fractionPattern = /(?:(\d+)(?:\s+|-))?(\d+\/\d+)/g;

    function replaceFractionsWithDecimals(value) {
        return value.replace(fractionPattern, (_, whole, fraction) => {
            const [numerator, denominator] = fraction.split("/").map(Number);
            if (!Number.isFinite(numerator) || !Number.isFinite(denominator) || denominator === 0) return "invalid";
            const decimal = (Number(whole || 0) + Math.round((numerator / denominator) * 100000000) / 100000000);
            return decimal.toString();
        });
    }

    function isExpectedDropSize(value) {
        const dimensions = replaceFractionsWithDecimals(value).trim().split(/\s*x\s*/i);
        return dimensions.length === 2 && dimensions.every(dimension => /^\d+(?:\.\d+)?$/.test(dimension) && Number(dimension) > 0);
    }

    function addExpectedDropWhenValid() {
        if (!expectedDropList || !expectedDropTemplate) return;
        const inputs = expectedDropList.querySelectorAll(".expected-drop-size");
        const lastInput = inputs[inputs.length - 1];
        if (!lastInput || !isExpectedDropSize(lastInput.value)) return;

        const index = inputs.length;
        const fragment = expectedDropTemplate.content.cloneNode(true);
        fragment.querySelectorAll("[name]").forEach(input => input.name = input.name.replace("__index__", index));
        expectedDropList.appendChild(fragment);
    }

    expectedDropList?.addEventListener("input", event => {
        if (event.target.classList.contains("expected-drop-size")) addExpectedDropWhenValid();
    });
    addExpectedDropWhenValid();
</script>