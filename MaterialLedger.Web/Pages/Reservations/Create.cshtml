@* MaterialLedger.Web/Pages/Reservations/Create.cshtml *@
@page "{inventoryItemId:long?}"
@model MaterialLedger.Web.Pages.Reservations.CreateModel
@using MaterialLedger.Web.Shared
@{ Layout = "Shared/_Layout"; }

<header class="page-heading">
    <p class="eyebrow">Cutting workflow</p>
    <h1>Hold material for work</h1>
    <p>Record the work context that is known now. Additional identifiers stay available without blocking the hold.</p>
</header>

<section aria-label="Selected material">
    <h2>Selected material</h2>
    <table class="selected-material-summary">
        <tbody>
            <tr><th scope="row">Item</th><td>@Model.Item?.PublicItemCode</td></tr>
            <tr><th scope="row">Material</th><td>@Model.Item?.MaterialSpecDisplayName</td></tr>
            <tr><th scope="row">Available quantity</th><td>@(Model.Item is null ? null : DisplayFormat.Quantity(Model.Item.AvailableQuantity))</td></tr>
            <tr><th scope="row">Usable size</th><td>@(Model.Item?.UsableWidthIn is not null ? $"{Model.Item.UsableWidthIn} × {Model.Item.UsableLengthIn} in" : "Not recorded")</td></tr>
            <tr><th scope="row">Location</th><td>@Model.Item?.LocationCode</td></tr>
        </tbody>
    </table>
</section>

@if (Model.Error is not null)
{
    <p style="color:red">@Model.Error</p>
}

<form method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="InventoryItemId" />
    <input type="hidden" asp-for="CorrelationId" />

    <fieldset>
        <legend>Work details</legend>
        <label>Work reference <input asp-for="DrawingId" /></label>
        <p>Enter the job, drawing, or nest identifier your team will recognize. Leave it blank only for an <strong>Unassigned material hold</strong>.</p>
    </fieldset>

    <fieldset>
        <legend>Equipment</legend>
        <label>Equipment
            <select asp-for="Equipment">
                <option value="">-- unspecified --</option>
                <option value="Laser">Laser</option>
                <option value="Plasma">Plasma</option>
                <option value="Shear">Shear</option>
                <option value="Other">Other</option>
            </select>
        </label>
    </fieldset>

    <fieldset>
        <legend>Expected usable drops</legend>
        <label><input asp-for="HasManualEstimate" type="checkbox" /> Record calculated usable drops expected after this cut</label>
        <div id="expected-remnant-list">
            <div class="remnant-entry">
                <label>Expected width (in) <input name="ExpectedRemnants[0].WidthIn" value="@Model.ExpectedRemnants[0].WidthIn" type="number" min="0.001" step="0.001" /></label>
                <label>Expected length (in) <input name="ExpectedRemnants[0].LengthIn" value="@Model.ExpectedRemnants[0].LengthIn" type="number" min="0.001" step="0.001" /></label>
            </div>
        </div>
        <button id="add-expected-remnant" type="button" class="button button-secondary">Add another expected drop</button>
        <template id="expected-remnant-template">
            <div class="remnant-entry">
                <label>Expected width (in) <input name="ExpectedRemnants[__index__].WidthIn" type="number" min="0.001" step="0.001" /></label>
                <label>Expected length (in) <input name="ExpectedRemnants[__index__].LengthIn" type="number" min="0.001" step="0.001" /></label>
            </div>
        </template>
    </fieldset>

    <details class="additional-traceability">
        <summary>Additional traceability</summary>
        <p>Optional technical identifiers are retained for audit and can be recorded when available.</p>
        <label>ShopOps job ID <input asp-for="ShopOpsJobId" /></label>
        <label>Drawing revision <input asp-for="DrawingRevision" /></label>
        <label>PEP nest year <input asp-for="PepNestYear" type="number" /></label>
        <label>PEP nest name <input asp-for="PepNestName" /></label>
        <label>Program record ID <input asp-for="LaserProgramRecordId" /></label>
    </details>

    <button type="submit">Hold material for work</button>
</form>

<script>
    document.getElementById("add-expected-remnant")?.addEventListener("click", () => {
        const list = document.getElementById("expected-remnant-list");
        const template = document.getElementById("expected-remnant-template");
        if (!list || !template) return;
        const index = list.querySelectorAll(".remnant-entry").length;
        const fragment = template.content.cloneNode(true);
        fragment.querySelectorAll("[name]").forEach(input => input.name = input.name.replace("__index__", index));
        list.appendChild(fragment);
    });
</script>
