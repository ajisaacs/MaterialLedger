@page
@using MaterialLedger.Data.Models
@using MaterialLedger.Web.Shared
@model MaterialLedger.Web.Pages.IndexModel
@{ Layout = "Shared/_Layout"; ViewData["Title"] = "Material control"; }

<header class="workboard-toolbar">
    <div>
        <h1>Workboard</h1>
        <p>@Model.Summary.AvailableMaterialCount available item@(Model.Summary.AvailableMaterialCount == 1 ? "" : "s")</p>
    </div>
    <div class="workboard-toolbar-actions">
        <a class="button" asp-page="/Inventory/Search">Find material</a>
        @if (User.IsInRole("Programmer") || User.IsInRole("Manager"))
        {
            <button class="button button-primary" type="button" onclick="document.getElementById('add-sheet-dialog').showModal()">Add a sheet</button>
        }
    </div>
</header>

@if (User.IsInRole("Programmer") || User.IsInRole("Manager"))
{
    <dialog id="add-sheet-dialog" class="sheet-entry-dialog" aria-labelledby="add-sheet-title">
        <div class="dialog-heading">
            <div>
                <p class="eyebrow">Count existing material</p>
                <h2 id="add-sheet-title">Add a sheet</h2>
                <p>Record one sheet that is already on the shop floor.</p>
            </div>
            <form method="dialog"><button class="dialog-close" type="submit" aria-label="Close add sheet">×</button></form>
        </div>
        <div id="add-sheet-log" class="sheet-entry-log" hidden>
            <p class="form-hint">Added this session:</p>
            <ul id="add-sheet-log-list"></ul>
        </div>
        <p id="add-sheet-error" class="form-error" role="alert" hidden></p>
        <form method="post" action="?handler=AddSheet" class="sheet-entry-form">
            @Html.AntiForgeryToken()
            <label>Rack
                <select id="new-sheet-rack" required>
                    <option value="">Choose rack</option>
                    @foreach (var rack in Model.MaterialLocations.Select(x => x.ParentInventoryLocation).OfType<InventoryLocation>().DistinctBy(x => x.InventoryLocationId).OrderBy(x => x.SortOrder))
                    {
                        <option value="@rack.InventoryLocationId">@rack.DisplayName</option>
                    }
                </select>
            </label>
            <label>Slot
                <select asp-for="NewSheet.LocationId" id="new-sheet-slot" required disabled>
                    <option value="">Choose slot</option>
                    @foreach (var location in Model.MaterialLocations)
                    {
                        <option value="@location.InventoryLocationId" data-rack-id="@location.ParentInventoryLocationId">@location.LocationCode</option>
                    }
                </select>
            </label>
            <fieldset>
                <legend>Material</legend>
                <label>Material family / grade / finish
                    <select id="new-sheet-material" required>
                        <option value="">Choose material</option>
                        @foreach (var material in Model.AvailableSpecs.GroupBy(spec => $"{spec.MaterialFamily}|{spec.Grade}|{spec.Finish}"))
                        {
                            var spec = material.First();
                            <option value="@material.Key">@spec.MaterialFamily@(spec.Grade is null ? "" : $" {spec.Grade}")@(spec.Finish is null ? "" : $" {spec.Finish}")</option>
                        }
                    </select>
                </label>
                <label>Thickness
                    <select asp-for="NewSheet.ExistingMaterialSpecId" id="new-sheet-thickness" required disabled>
                        <option value="">Choose thickness</option>
                        @foreach (var spec in Model.AvailableSpecs)
                        {
                            <option value="@spec.MaterialSpecId" data-material-key="@($"{spec.MaterialFamily}|{spec.Grade}|{spec.Finish}")">@spec.DisplayName</option>
                        }
                    </select>
                </label>
                <p class="form-hint">Need a material that is not listed? <a asp-page="/Materials/Index">Add it to the material catalog</a>.</p>
            </fieldset>
            <fieldset>
                <legend>Sheet size</legend>
                <p class="form-hint">One full sheet will be recorded.</p>
                <div class="sheet-entry-grid">
                    <label>Usable width (in) <input asp-for="NewSheet.UsableWidthIn" type="number" step="0.001" min="0" /></label>
                    <label>Usable length (in) <input asp-for="NewSheet.UsableLengthIn" type="number" step="0.001" min="0" /></label>
                </div>
            </fieldset>
            <label class="checkbox-label"><input asp-for="NewSheet.IsQuarantined" type="checkbox" /> Unknown or questionable — quarantine it</label>
            <label>Notes <textarea asp-for="NewSheet.Notes"></textarea></label>
            <div class="dialog-actions"><button type="submit">Add sheet</button><button type="button" class="button-secondary" onclick="document.getElementById('add-sheet-dialog').close()">Cancel</button></div>
        </form>
    </dialog>
    <script src="~/js/dependent-select.js" asp-append-version="true"></script>
    <script>
        initDependentSelect(document.getElementById('new-sheet-material'), document.getElementById('new-sheet-thickness'), 'materialKey');
        initDependentSelect(document.getElementById('new-sheet-rack'), document.getElementById('new-sheet-slot'), 'rackId');
    </script>
    <script src="~/js/quick-sheet-entry.js" asp-append-version="true"></script>
    <script>
        initAddSheetForm(document.getElementById('add-sheet-dialog'));
    </script>
}

<section class="workboard-section" aria-labelledby="action-queue-heading">
    <div class="workboard-section-heading"><h2 id="action-queue-heading">Action queue</h2></div>
    <div class="action-queue">
        @if (Model.Summary.AttentionNeededCount > 0)
        {
            <a class="action-queue-row action-queue-row-alert" asp-page="/Exceptions/Index"><strong>Attention needed</strong><span>@Model.Summary.AttentionNeededCount open review item@(Model.Summary.AttentionNeededCount == 1 ? "" : "s")</span><b>Review</b></a>
        }
        @if ((User.IsInRole("Programmer") || User.IsInRole("Manager")) && Model.Summary.ApprovalNeededCount > 0)
        {
            <a class="action-queue-row" asp-page="/Reservations/Index" asp-route-Status="Proposed"><strong>Holds awaiting approval</strong><span>@Model.Summary.ApprovalNeededCount hold@(Model.Summary.ApprovalNeededCount == 1 ? "" : "s")</span><b>Approve</b></a>
        }
        @if ((User.IsInRole("Operator") || User.IsInRole("Manager")) && Model.Summary.CutResultNeededCount > 0)
        {
            <a class="action-queue-row action-queue-row-warning" asp-page="/Closeout/Index" asp-route-Status="AwaitingCloseout"><strong>Record cut result</strong><span>@Model.Summary.CutResultNeededCount work item@(Model.Summary.CutResultNeededCount == 1 ? "" : "s")</span><b>Record</b></a>
        }
        @if (Model.Summary.ReadyForCuttingCount > 0)
        {
            <a class="action-queue-row" asp-page="/Reservations/Index" asp-route-Status="Approved"><strong>Ready for cutting</strong><span>@Model.Summary.ReadyForCuttingCount approved hold@(Model.Summary.ReadyForCuttingCount == 1 ? "" : "s")</span><b>View queue</b></a>
        }
        @if (Model.Summary.AttentionNeededCount == 0 && Model.Summary.ApprovalNeededCount == 0 && Model.Summary.CutResultNeededCount == 0 && Model.Summary.ReadyForCuttingCount == 0)
        {
            <p class="empty-state">No material work needs action.</p>
        }
    </div>
</section>

<section class="workboard-section" aria-labelledby="find-material-heading">
    <div class="workboard-section-heading"><h2 id="find-material-heading">Find material</h2><a asp-page="/Inventory/Search">Advanced filters</a></div>
    <form class="workboard-search" method="get" action="/Inventory/Search">
        <label for="workboard-material-family">Material, grade, finish, or location</label>
        <input id="workboard-material-family" name="MaterialFamily" type="search" placeholder="Search available inventory" />
        <input type="hidden" name="AvailableOnly" value="true" />
        <button class="button button-primary" type="submit">Search</button>
    </form>
</section>

<section class="workboard-section" aria-labelledby="quick-actions-heading">
    <div class="workboard-section-heading"><h2 id="quick-actions-heading">Quick actions</h2></div>
    <div class="quick-actions">
        @if (User.IsInRole("Programmer") || User.IsInRole("Manager"))
        {
            <a class="button button-secondary" asp-page="/Inventory/Search">Hold material for work</a>
            <a class="button button-secondary" asp-page="/Receiving/SelectLocation">Receive delivery</a>
            <a class="button button-secondary" asp-page="/Census/SelectSlot">Count existing material</a>
            <a class="button button-secondary" asp-page="/Materials/Index">Material catalog</a>
        }
        <a class="button button-secondary" asp-page="/PepNests/Index">PEP nests</a>
    </div>
</section>

<section class="workboard-section" aria-labelledby="recent-work-heading">
    <div class="workboard-section-heading"><h2 id="recent-work-heading">Recent activity</h2><a asp-page="/Reservations/Index">View material holds</a></div>
    @if (Model.Summary.RecentWork.Count == 0)
    {
        <p class="empty-state">No material work has been recorded yet.</p>
    }
    else
    {
        <table class="recent-work-table desktop-table">
            <thead><tr><th>When</th><th>Material item</th><th>Work</th><th>Workflow</th></tr></thead>
            <tbody>
            @foreach (var work in Model.Summary.RecentWork)
            {
                <tr>
                    <td>@DisplayFormat.LocalDateTime(work.TimestampUtc)</td>
                    <td><a asp-page="/Inventory/Details" asp-route-id="@work.InventoryItemId">@work.PublicItemCode</a></td>
                    <td><a asp-page="/Reservations/Details" asp-route-id="@work.MaterialReservationId">@work.WorkReference</a></td>
                    <td>@work.WorkflowLabel</td>
                </tr>
            }
            </tbody>
        </table>
        <div class="recent-work-card-grid mobile-card">
            @foreach (var work in Model.Summary.RecentWork)
            {
                <article class="recent-work-card">
                    <header class="recent-work-card-header">
                        <a asp-page="/Inventory/Details" asp-route-id="@work.InventoryItemId"><strong>@work.PublicItemCode</strong></a>
                        <span>@work.WorkflowLabel</span>
                    </header>
                    <dl class="recent-work-card-body">
                        <div><dt>Material</dt><dd>@work.MaterialDisplayName</dd></div>
                        <div><dt>Location</dt><dd>@work.LocationCode</dd></div>
                        <div><dt>Work</dt><dd><a asp-page="/Reservations/Details" asp-route-id="@work.MaterialReservationId">@work.WorkReference</a></dd></div>
                        <div><dt>Equipment</dt><dd>@work.Equipment</dd></div>
                        <div><dt>When</dt><dd>@DisplayFormat.LocalDateTime(work.TimestampUtc)</dd></div>
                    </dl>
                </article>
            }
        </div>
    }
</section>
