@page
@model MaterialLedger.Web.Pages.PurchaseOrders.CreateModel
@{ Layout = "Shared/_Layout"; ViewData["Title"] = "Order material"; }
<header class="page-heading"><p class="eyebrow">Inventory setup</p><h1>Order material</h1><p>Select a vendor reference, then add each material as a line.</p></header>
@if (Model.Error is not null) { <p class="form-error" role="alert">@Model.Error</p> }
<form method="post" id="purchase-order-form" class="purchase-order-form">
    @Html.AntiForgeryToken()<input type="hidden" asp-for="CorrelationId" />
    <fieldset><legend>Order details</legend>
        <label>Vendor
            <select asp-for="VendorId" id="vendor-id"><option value="">Choose active vendor</option>@foreach (var vendor in Model.AvailableVendors) { <option value="@vendor.VendorId">@vendor.Name</option> }</select>
        </label>
        <p class="form-hint">Or create an active reference for this order:</p>
        <label>New vendor name <input asp-for="NewVendorName" maxlength="200" autocomplete="organization" /></label>
        <label>PO number <input asp-for="PurchaseOrderNumber" maxlength="100" required /></label>
        <label>Order date <input asp-for="OrderDate" type="date" /></label>
        <label>Notes <textarea asp-for="Notes" maxlength="1000"></textarea></label>
    </fieldset>
    <fieldset><legend>Material lines</legend><p class="form-hint">Material and quantity are required for each filled-in line. Select an active vendor part or enter a new one to create it under the selected vendor.</p>
    @for (var i = 0; i < Model.Lines.Count; i++)
    {
        <fieldset class="po-line"><legend>Line @(i + 1)</legend>
            <label>Material
                <select asp-for="Lines[i].ExistingMaterialSpecId"><option value="">Choose material / thickness</option>@foreach (var spec in Model.AvailableSpecs) { <option value="@spec.MaterialSpecId">@spec.DisplayName</option> }</select>
            </label>
            <label>Vendor part
                <select asp-for="Lines[i].VendorPartId" class="vendor-part"><option value="">No vendor part</option>@foreach (var part in Model.AvailableVendorParts) { <option value="@part.VendorPartId" data-vendor-id="@part.VendorId">@part.PartNumber</option> }</select>
            </label>
            <label>New vendor part number <input asp-for="Lines[i].NewVendorPartNumber" maxlength="100" /></label>
            <label>Vendor description <input asp-for="Lines[i].VendorDescription" maxlength="200" /></label>
            <label>Quantity ordered <input asp-for="Lines[i].QuantityOrdered" type="number" step="1" min="0" /></label>
            <label>Unit price <input asp-for="Lines[i].UnitPrice" type="number" step="0.01" min="0" /></label>
            <label>Usable width (in) <input asp-for="Lines[i].UsableWidthIn" type="number" step="0.001" /></label>
            <label>Usable length (in) <input asp-for="Lines[i].UsableLengthIn" type="number" step="0.001" /></label>
            <label>Quoted delivery date <input asp-for="Lines[i].QuotedDeliveryDate" type="date" /></label>
        </fieldset>
    }
    </fieldset>
    <button type="submit">Create purchase order</button>
</form>
<script>
const vendor = document.getElementById('vendor-id');
function filterParts() { document.querySelectorAll('.vendor-part').forEach(select => {
  [...select.options].forEach(option => { if (!option.dataset.vendorId) return; option.hidden = option.dataset.vendorId !== vendor.value; });
  if (select.selectedOptions[0]?.hidden) select.value = '';
}); }
vendor.addEventListener('change', filterParts); filterParts();
</script>
