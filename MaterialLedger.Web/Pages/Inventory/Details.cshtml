@* MaterialLedger.Web/Pages/Inventory/Details.cshtml *@
@page "{id:long}"
@model MaterialLedger.Web.Pages.Inventory.DetailsModel
@using MaterialLedger.Data.Models
@using MaterialLedger.Web.Shared
@using MaterialLedger.Data.Inventory
@{ Layout = "Shared/_Layout"; }

<header class="page-heading">
    <p class="eyebrow">Inventory item</p>
    <h1>@Model.Item!.PublicItemCode</h1>
    <p>@Model.Item.MaterialSpecDisplayName</p>
</header>

<section aria-label="Item details">
    <dl class="detail-grid">
        <dt>Kind</dt><dd>@Model.Item.ItemKind</dd>
        <dt>Status</dt>
        <dd><span class="inventory-status inventory-status-@Model.Item.Status.ToString().ToLowerInvariant() @(Model.Item.IsStale ? "inventory-status-stale" : "")">@Model.Item.Status@(Model.Item.IsStale ? " — review before use" : "")</span></dd>
        <dt>Quantity</dt><dd>@DisplayFormat.Quantity(Model.Item.AvailableQuantity) of @DisplayFormat.Quantity(Model.Item.QuantityOnHand)</dd>
        <dt>Usable size</dt><dd>@(Model.Item.UsableWidthIn is not null ? $"{DisplayFormat.Quantity(Model.Item.UsableWidthIn.Value)} x {DisplayFormat.Quantity(Model.Item.UsableLengthIn!.Value)} in" : "-")</dd>
        <dt>Location</dt><dd><a asp-page="/Inventory/Search" asp-route-LocationCode="@Model.Item.LocationCode" asp-route-AvailableOnly="false">@Model.Item.LocationCode</a></dd>
        <dt>Last observed</dt><dd>@DisplayFormat.LocalDateTime(Model.Item.LastObservedAtUtc) by @Model.Item.LastObservedByDisplayName</dd>
        @if (Model.Item.ItemKind == InventoryItemKind.Drop)
        {
            <dt>Cut from</dt>
            <dd>
                @if (Model.SourceSheet is not null)
                {
                    <text><a asp-page="Details" asp-route-id="@Model.SourceSheet.InventoryItemId">@Model.SourceSheet.PublicItemCode</a> — @Model.SourceSheet.MaterialSpecDisplayName</text>
                }
                else
                {
                    @:Not recorded
                }
            </dd>
        }
    </dl>
</section>

@if (Model.Reservations.Count > 0 || Model.Exceptions.Count > 0)
{
    <section aria-label="Current holds">
        <h2>Current holds</h2>
        <div class="holds-grid">
            @if (Model.Reservations.Count > 0)
            {
                <div class="hold-card">
                    <h3>Reservations <span class="badge">@Model.Reservations.Count</span></h3>
                    <table class="compact-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Status</th>
                                <th>Reference</th>
                                <th>Created</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Reservations)
                            {
                                <tr>
                                    <td><a asp-page="/Reservations/Details" asp-route-id="@r.ReservationId">@r.ReservationId</a></td>
                                    <td><span class="workflow-status @(r.IsActive ? "ready" : "pending")">@r.Status</span></td>
                                    <td>@(r.WorkReference ?? "-")</td>
                                    <td>@r.CreatedAt.ToString("MMM d, HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (Model.Exceptions.Count > 0)
            {
                <div class="hold-card">
                    <h3>Exceptions <span class="badge">@Model.Exceptions.Count</span></h3>
                    <table class="compact-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Opened</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var e in Model.Exceptions)
                            {
                                <tr>
                                    <td><a asp-page="/Exceptions/Details" asp-route-id="@e.ExceptionId">@e.ExceptionId</a></td>
                                    <td>@e.ExceptionType</td>
                                    <td><span class="exception-badge @(e.Status == "Open" ? "exception-open" : "exception-fixed")">@e.Status</span></td>
                                    <td>@e.OpenedAt.ToString("MMM d, HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
}

@if (Model.Transactions.Count > 0)
{
    <section aria-label="Recent activity">
        <h2>Recent activity <span class="activity-count">Last @Model.Transactions.Count entries</span></h2>
        <table class="compact-table activity-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Type</th>
                    <th>When</th>
                    <th>By</th>
                    <th>Geometry</th>
                    <th>Notes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Transactions)
                {
                    <tr>
                        <td>@t.TransactionId</td>
                        <td><span class="tx-type">@t.Type</span></td>
                        <td>@t.OccurredAt.ToString("MMM d, HH:mm")</td>
                        <td>@t.RecordedBy</td>
                        <td>@(t.Geometry ?? "-")</td>
                        <td class="notes-cell">@(t.Notes ?? (t.ReasonCode != null ? t.ReasonCode : "-"))</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

<p><a asp-page="/Inventory/Search">Back to search</a></p>
