@page
@model MaterialLedger.Web.Pages.Inventory.SearchModel
@using MaterialLedger.Data.Models
@using MaterialLedger.Web.Shared
@{ Layout = "Shared/_Layout"; }
@{
    var appliedFilterCount = 0;
    if (!string.IsNullOrWhiteSpace(Model.MaterialFamily)) { appliedFilterCount++; }
    if (Model.ThicknessIn is not null) { appliedFilterCount++; }
    if (Model.MinUsableWidthIn is not null || Model.MinUsableLengthIn is not null) { appliedFilterCount++; }
    if (!string.IsNullOrWhiteSpace(Model.Grade)) { appliedFilterCount++; }
    if (!string.IsNullOrWhiteSpace(Model.Finish)) { appliedFilterCount++; }
    if (Model.ItemKind is not null) { appliedFilterCount++; }
    if (!string.IsNullOrWhiteSpace(Model.LocationCode)) { appliedFilterCount++; }
    if (!Model.AvailableOnly) { appliedFilterCount++; }

    var itemKindLabel = Model.ItemKind switch
    {
        InventoryItemKind.FullSheetBundle => "Full sheet / bundle",
        InventoryItemKind.FullSheet => "Single full sheet",
        InventoryItemKind.Drop => "Drop",
        _ => null
    };
}

<header class="page-heading">
    <p class="eyebrow">Cutting workflow</p>
    <h1>Find material</h1>
    <p>Search available stock and drops, then hold the selected item for work.</p>
</header>
@if (TempData["Message"] is string message)
{
    <p class="alert-success" role="status">@message</p>
}

<section class="inventory-search-bar" aria-label="Applied inventory filters">
    <div class="inventory-filter-heading">
        <div>
            <p class="eyebrow">Search filters</p>
            <h2>Current filters</h2>
        </div>
        <button type="button" class="button button-primary" onclick="document.getElementById('inventory-filter-dialog').showModal()">Filters@(appliedFilterCount > 0 ? $" ({appliedFilterCount})" : "")</button>
    </div>

    <ul class="active-filter-list">
        @if (!string.IsNullOrWhiteSpace(Model.MaterialFamily)) { <li><strong>Material:</strong> @Model.MaterialFamily</li> }
        @if (Model.ThicknessIn is not null) { <li><strong>Thickness:</strong> @Model.ThicknessIn in</li> }
        @if (Model.MinUsableWidthIn is not null || Model.MinUsableLengthIn is not null) { <li><strong>Minimum usable size:</strong> ≥ @(Model.MinUsableWidthIn?.ToString() ?? "any") × @(Model.MinUsableLengthIn?.ToString() ?? "any") in</li> }
        @if (!string.IsNullOrWhiteSpace(Model.Grade)) { <li><strong>Grade:</strong> @Model.Grade</li> }
        @if (!string.IsNullOrWhiteSpace(Model.Finish)) { <li><strong>Finish:</strong> @Model.Finish</li> }
        @if (itemKindLabel is not null) { <li><strong>Kind:</strong> @itemKindLabel</li> }
        @if (!string.IsNullOrWhiteSpace(Model.LocationCode)) { <li><strong>Location:</strong> @Model.LocationCode</li> }
        <li><strong>Availability:</strong> @(Model.AvailableOnly ? "Available only" : "All inventory")</li>
    </ul>

    @if (appliedFilterCount > 0)
    {
        <a class="clear-filters" asp-page="/Inventory/Search">Clear all filters</a>
    }
</section>

<dialog id="inventory-filter-dialog" class="inventory-filter-dialog" aria-labelledby="inventory-filter-dialog-title">
    <div class="dialog-heading">
        <div>
            <p class="eyebrow">Inventory search</p>
            <h2 id="inventory-filter-dialog-title">Filter material</h2>
            <p>Set one or more criteria, then apply them to the inventory list.</p>
        </div>
        <form method="dialog"><button class="dialog-close" type="submit" aria-label="Close filters">×</button></form>
    </div>

    <form method="get" class="inventory-filter-form">
        <div class="inventory-filter-fields">
            <label>Material family <input asp-for="MaterialFamily" /></label>
            <label>Thickness (in) <input asp-for="ThicknessIn" type="number" step="0.0001" /></label>
            <fieldset class="dimension-filter">
                <legend>Minimum usable size (in)</legend>
                <label>Width <input asp-for="MinUsableWidthIn" type="number" step="0.001" /></label>
                <span aria-hidden="true">×</span>
                <label>Length <input asp-for="MinUsableLengthIn" type="number" step="0.001" /></label>
            </fieldset>
            <label>Grade <input asp-for="Grade" /></label>
            <label>Finish <input asp-for="Finish" /></label>
            <label>Kind
                <select asp-for="ItemKind">
                    <option value="">-- any --</option>
                    <option value="FullSheetBundle">Full sheet / bundle</option>
                    <option value="FullSheet">Single full sheet</option>
                    <option value="Drop">Drop</option>
                </select>
            </label>
            <label>Location code <input asp-for="LocationCode" /></label>
            <label class="available-toggle"><input asp-for="AvailableOnly" type="checkbox" /> Available only</label>
        </div>
        <div class="dialog-actions">
            <button type="submit">Apply filters</button>
            <a class="button button-secondary" asp-page="/Inventory/Search">Clear all</a>
            <button type="button" class="button-secondary" onclick="document.getElementById('inventory-filter-dialog').close()">Cancel</button>
        </div>
    </form>
</dialog>

<p class="result-count">@Model.Results.Count matching item@(Model.Results.Count == 1 ? "" : "s")</p>
@if (Model.Results.Count == 0)
{
    <p class="empty-state">No matching inventory items.</p>
}
else
{
<table class="desktop-table">
    <thead>
        <tr><th>Item</th><th>Material</th><th>Thickness</th><th>Qty</th><th>Usable size</th><th>Location</th><th>Last observed</th><th>Status</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var r in Model.Results)
    {
        <tr>
            <td><a asp-page="Details" asp-route-id="@r.InventoryItemId">@r.PublicItemCode</a></td>
            <td>@r.MaterialDescription</td>
            <td>@DisplayFormat.Thickness(r.ThicknessIn, r.GaugeLabel)</td>
            <td>@DisplayFormat.Quantity(r.AvailableQuantity) of @DisplayFormat.Quantity(r.QuantityOnHand)</td>
            <td>@if (r.UsableWidthIn is not null)
                {
                    <span class="usable-size"><span class="usable-size-dim">@DisplayFormat.Quantity(r.UsableWidthIn.Value)</span><span class="usable-size-x">x</span><span class="usable-size-dim">@DisplayFormat.Quantity(r.UsableLengthIn!.Value)</span></span>
                }
                else
                {
                    @:-
                }</td>
            <td>@r.LocationCode</td>
            <td>@DisplayFormat.LocalDateTime(r.LastObservedAtUtc) by @r.LastObservedByDisplayName @(r.IsStale ? "(STALE)" : "")</td>
            <td><span class="inventory-status inventory-status-@r.Status.ToString().ToLowerInvariant() @(r.IsStale ? "inventory-status-stale" : "")">@r.Status@(r.IsStale ? " — review before use" : "")</span></td>
            <td>
            @if (Model.CanReserve && r.AvailableQuantity > 0 && !r.IsStale && r.Status != InventoryItemStatus.Quarantined)
            {
                <a asp-page="/Reservations/Create" asp-route-inventoryItemId="@r.InventoryItemId">Hold for work</a>
            }
            </td>
        </tr>
    }
    </tbody>
</table>

<div class="mobile-card-grid mobile-card" aria-label="Matching inventory items">
@foreach (var r in Model.Results)
{
    var canReserve = Model.CanReserve && r.AvailableQuantity > 0 && !r.IsStale && r.Status != InventoryItemStatus.Quarantined;
    <article class="inventory-card">
        <div class="inventory-card-header">
            <a class="inventory-card-item" asp-page="Details" asp-route-id="@r.InventoryItemId">@r.PublicItemCode</a>
            <span class="inventory-status inventory-status-@r.Status.ToString().ToLowerInvariant() @(r.IsStale ? "inventory-status-stale" : "")">@r.Status@(r.IsStale ? " — review" : "")</span>
        </div>
        <dl class="inventory-card-body">
            <dt>Material</dt><dd>@r.MaterialDescription</dd>
            <dt>Thickness</dt><dd>@DisplayFormat.Thickness(r.ThicknessIn, r.GaugeLabel)</dd>
            <dt>Available</dt><dd>@DisplayFormat.Quantity(r.AvailableQuantity) of @DisplayFormat.Quantity(r.QuantityOnHand)</dd>
            <dt>Usable size</dt>
            <dd>
                @if (r.UsableWidthIn is not null)
                {
                    <span>@DisplayFormat.Quantity(r.UsableWidthIn.Value) × @DisplayFormat.Quantity(r.UsableLengthIn!.Value)</span>
                }
                else
                {
                    <span>-</span>
                }
            </dd>
            <dt>Location</dt><dd>@r.LocationCode</dd>
            <dt>Last observed</dt><dd>@DisplayFormat.LocalDateTime(r.LastObservedAtUtc) by @r.LastObservedByDisplayName</dd>
        </dl>
        <div class="inventory-card-actions">
            <a class="button button-secondary" asp-page="Details" asp-route-id="@r.InventoryItemId">View item</a>
            @if (canReserve)
            {
                <a class="button button-primary" asp-page="/Reservations/Create" asp-route-inventoryItemId="@r.InventoryItemId">Hold for work</a>
            }
        </div>
    </article>
}
</div>
}
