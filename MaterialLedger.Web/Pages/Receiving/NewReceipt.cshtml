@page
@model MaterialLedger.Web.Pages.Receiving.NewReceiptModel
@{ Layout = "Shared/_Layout"; }
<h1>Receive material — @Model.Location?.LocationCode</h1>
@if (Model.PurchaseOrderLine is not null) { <p>Receiving against PO <strong>@Model.PurchaseOrderLine.PurchaseOrder!.PurchaseOrderNumber</strong>, line @Model.PurchaseOrderLine.LineNumber — @(Model.PurchaseOrderLine.PurchaseOrder.Vendor?.Name ?? "vendor reference") / @(Model.PurchaseOrderLine.VendorPart?.PartNumber ?? "no vendor part"). Reference values are locked to the PO.</p> }
@if (Model.Error is not null) { <p class="form-error" role="alert">@Model.Error</p> }
<form method="post">@Html.AntiForgeryToken()<input type="hidden" asp-for="LocationId" /><input type="hidden" asp-for="CorrelationId" /><input type="hidden" asp-for="PoLineId" />
<fieldset><legend>Material</legend><label>Material / thickness <select asp-for="ExistingMaterialSpecId" required><option value="">Choose material / thickness</option>@foreach(var spec in Model.AvailableSpecs) { <option value="@spec.MaterialSpecId">@spec.DisplayName</option> }</select></label><p>Need a material that is not listed? <a asp-page="/Materials/Index">Add it to the material catalog</a>.</p></fieldset>
<fieldset><legend>Item</legend><label><input type="radio" asp-for="ItemKind" value="FullSheetBundle" /> Full sheet / bundle</label><label><input type="radio" asp-for="ItemKind" value="FullSheet" /> Single full sheet</label><label>Quantity <input asp-for="Quantity" type="number" step="1" /></label><label>Usable width (in) <input asp-for="UsableWidthIn" type="number" step="0.001" /></label><label>Usable length (in) <input asp-for="UsableLengthIn" type="number" step="0.001" /></label><label>Shape <select asp-for="ShapeClassification"><option value="Rectangular">Rectangular</option><option value="IrregularConservativeRectangle">Irregular (conservative rectangle)</option><option value="Unknown">Unknown</option></select></label></fieldset>
<fieldset><legend>Receiving details</legend>
@if(Model.PurchaseOrderLine is not null) { <input type="hidden" asp-for="VendorId" /><input type="hidden" asp-for="VendorPartId" /><input type="hidden" asp-for="PurchaseOrderNumber" /> }
else { <label>Vendor (optional) <select asp-for="VendorId" id="vendor-id"><option value="">No vendor</option>@foreach(var vendor in Model.AvailableVendors) { <option value="@vendor.VendorId">@vendor.Name</option> }</select></label><label>Vendor part (optional) <select asp-for="VendorPartId" id="vendor-part"><option value="">No vendor part</option>@foreach(var part in Model.AvailableVendorParts) { <option value="@part.VendorPartId" data-vendor-id="@part.VendorId">@part.PartNumber</option> }</select></label><label>PO number (required) <input asp-for="PurchaseOrderNumber" maxlength="100" /></label> }
<label>Receipt number <input asp-for="ReceiptNumber" maxlength="100" /></label><label>Heat/lot number <input asp-for="HeatLotNumber" maxlength="100" /></label><label>Cost per unit <input asp-for="CostPerUnit" type="number" step="0.01" min="0" /></label></fieldset>
<label><input type="checkbox" asp-for="IsQuarantined" /> Damaged / questionable on arrival — quarantine</label><label>Notes <textarea asp-for="Notes"></textarea></label><button type="submit">Receive material</button></form>
@if (Model.PurchaseOrderLine is null) { <script>const vendor=document.getElementById('vendor-id'),part=document.getElementById('vendor-part'); function filterParts(){[...part.options].forEach(o=>{if(o.dataset.vendorId)o.hidden=o.dataset.vendorId!==vendor.value});if(part.selectedOptions[0]?.hidden)part.value=''} vendor.addEventListener('change',filterParts);filterParts();</script> }
