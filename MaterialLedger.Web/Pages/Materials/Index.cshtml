@page
@model MaterialLedger.Web.Pages.Materials.IndexModel
@{ Layout = "Shared/_Layout"; ViewData["Title"] = "Material catalog"; }

<section class="control-header">
    <div>
        <h1>Material catalog</h1>
        <p>Add a catalog material before recording a received or counted sheet.</p>
    </div>
    <div class="control-header-actions">
        <button class="button button-primary" type="button" onclick="openAddMaterial()">Add material</button>
    </div>
</section>

@if (Model.Success is not null)
{
    <p role="status">@Model.Success</p>
}

<dialog id="add-material-dialog" class="sheet-entry-dialog" aria-labelledby="add-material-title">
    <div class="dialog-heading">
        <div>
            <h2 id="add-material-title">Add material</h2>
        </div>
        <form method="dialog"><button class="dialog-close" type="submit" aria-label="Close add material">×</button></form>
    </div>
    @if (Model.Error is not null)
    {
        <p class="form-error" role="alert">@Model.Error</p>
    }
    <form method="post">
        @Html.AntiForgeryToken()
        <fieldset>
            <label>Material family <input asp-for="NewMaterial.MaterialFamily" required maxlength="100" /></label>
            <label>Grade <input asp-for="NewMaterial.Grade" maxlength="100" /></label>
            <label>Finish <input asp-for="NewMaterial.Finish" maxlength="100" /></label>
            <label>Thickness (in) <input asp-for="NewMaterial.ThicknessIn" type="number" step="0.0001" min="0.0001" required /></label>
            <label>Gauge / label <input asp-for="NewMaterial.GaugeLabel" maxlength="20" placeholder="e.g. 16ga or 3/16" /></label>
        </fieldset>
        <div class="dialog-actions"><button id="add-material-submit" type="submit">Add material</button><button type="button" class="button-secondary" onclick="document.getElementById('add-material-dialog').close()">Cancel</button></div>
    </form>
</dialog>
@if (Model.ShowAddMaterialDialog)
{
    <script>document.addEventListener('DOMContentLoaded', () => document.getElementById('add-material-dialog').showModal());</script>
}

<section class="material-catalog" aria-labelledby="active-materials-title">
    <div class="material-catalog-heading">
        <div>
            <h2 id="active-materials-title">Active materials</h2>
            <p>Choose a material family, then use its available thicknesses when entering a sheet.</p>
        </div>
        <span class="material-catalog-count">@Model.MaterialGroups.Count material types</span>
    </div>

    <div class="material-catalog-grid">
    @foreach (var material in Model.MaterialGroups)
    {
        <article class="material-catalog-card" data-material-family="@material.MaterialFamily" data-grade="@material.Grade" data-finish="@material.Finish">
            <h3>@material.Name</h3>
            <table class="material-thickness-table desktop-table">
                <tbody>
            @foreach (var spec in material.Thicknesses)
            {
                <tr>
                    <th scope="row">@spec.GaugeLabel</th>
                    <td>@spec.ThicknessIn.ToString("0.####") in</td>
                </tr>
            }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="2"><button class="button button-secondary material-add-thickness" type="button" onclick="openAddThickness(this)">Add thickness</button></td>
                    </tr>
                </tfoot>
            </table>
            <details class="material-thickness-disclosure mobile-card">
                <summary><span>Available thicknesses</span><span>@material.Thicknesses.Count options</span></summary>
                <table class="material-thickness-table">
                    <tbody>
                @foreach (var spec in material.Thicknesses)
                {
                    <tr>
                        <th scope="row">@spec.GaugeLabel</th>
                        <td>@spec.ThicknessIn.ToString("0.####") in</td>
                    </tr>
                }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="2"><button class="button button-secondary material-add-thickness" type="button" onclick="openAddThickness(this)">Add thickness</button></td>
                        </tr>
                    </tfoot>
                </table>
            </details>
        </article>
    }
    </div>
</section>

<script>
    function openAddMaterial() {
        document.getElementById('NewMaterial_MaterialFamily').value = '';
        document.getElementById('NewMaterial_Grade').value = '';
        document.getElementById('NewMaterial_Finish').value = '';
        document.getElementById('NewMaterial_ThicknessIn').value = '';
        document.getElementById('NewMaterial_GaugeLabel').value = '';
        document.getElementById('add-material-title').textContent = 'Add material';
        document.getElementById('add-material-submit').textContent = 'Add material';
        document.getElementById('add-material-dialog').showModal();
        document.getElementById('NewMaterial_MaterialFamily').focus();
    }

    function openAddThickness(button) {
        const material = button.closest('.material-catalog-card').dataset;
        document.getElementById('NewMaterial_MaterialFamily').value = material.materialFamily;
        document.getElementById('NewMaterial_Grade').value = material.grade;
        document.getElementById('NewMaterial_Finish').value = material.finish;
        document.getElementById('NewMaterial_ThicknessIn').value = '';
        document.getElementById('NewMaterial_GaugeLabel').value = '';
        document.getElementById('add-material-title').textContent = 'Add thickness — ' + button.closest('.material-catalog-card').querySelector('h3').textContent;
        document.getElementById('add-material-submit').textContent = 'Add thickness';
        document.getElementById('add-material-dialog').showModal();
        document.getElementById('NewMaterial_ThicknessIn').focus();
    }
</script>
