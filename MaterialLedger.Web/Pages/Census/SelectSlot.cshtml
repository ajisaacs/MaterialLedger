@* MaterialLedger.Web/Pages/Census/SelectSlot.cshtml *@
@page
@model MaterialLedger.Web.Pages.Census.SelectSlotModel
@{ Layout = "Shared/_Layout"; ViewData["Title"] = "Count existing material"; }

<h1>Count existing material</h1>
<p>Choose the confirmed rack slot where you counted material already on hand.</p>
<table>
    <thead><tr><th>Rack</th><th>Slot</th><th></th></tr></thead>
    <tbody>
    @foreach (var slot in Model.ConfirmedSlots)
    {
        <tr>
            <td>@slot.ParentInventoryLocation?.DisplayName</td>
            <td>@slot.LocationCode</td>
            <td><a asp-page="NewOpeningBalance" asp-route-locationId="@slot.InventoryLocationId">Record counted balance</a></td>
        </tr>
    }
    </tbody>
</table>
