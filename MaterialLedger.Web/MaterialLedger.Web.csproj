<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>7af7f5df-cd94-4830-b249-ed94a1456580</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MaterialLedger.Data/MaterialLedger.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Required for dotnet ef design-time tooling: MaterialLedger.Data's Design package
         reference is PrivateAssets="all" and does not flow transitively, and this project
         is the startup project used to generate migrations. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
